# === Основные настройки ===
APP_ENV=development
# ВНИМАНИЕ: на проде сгенерируй новый ключ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=true

# Домен, на котором крутится приложение (только для prod).
# Должен быть настроен A-запись → IP этого сервера.
APP_DOMAIN=localhost

# === База данных ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smartmail
POSTGRES_USER=smartmail
POSTGRES_PASSWORD=smartmail-dev-password

# Полная строка подключения (собирается автоматически, но можно переопределить)
DATABASE_URL=postgresql+psycopg://smartmail:smartmail-dev-password@postgres:5432/smartmail

# === Redis / Celery ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === JWT ===
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === CRM Integration (внешний сервис клиентской базы) ===
CRM_API_BASE_URL=https://your-crm.example.com/api/v1
CRM_API_KEY=set-me
CRM_SYNC_INTERVAL_MINUTES=30

# === ESP (Email Service Provider) ===
# Варианты: smtp | unisender | sendgrid | mailgun
ESP_PROVIDER=smtp

# SMTP-настройки (если ESP_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_NAME=SmartMail
SMTP_FROM_EMAIL=noreply@example.com

# Unisender
UNISENDER_API_KEY=

# SendGrid
SENDGRID_API_KEY=

# === Scoring Service ===
# Варианты: mock | http
SCORING_PROVIDER=mock
SCORING_HTTP_URL=http://localhost:9000/score
SCORING_HTTP_TIMEOUT=5

# === Frontend (Vite) ===
VITE_API_BASE_URL=http://localhost:8000
